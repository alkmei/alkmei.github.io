---
import { getCollection } from "astro:content";

import ProjectCard from "../components/ProjectCard.astro";
import Layout from "../layouts/Layout.astro";

const projects = await getCollection("projects");
---

<Layout>
  <style>
    #slop-chars {
      letter-spacing: 0.05em;
      color: #6b7280;
    }
  </style>
  <h1 class="my-3 text-xl font-bold">Alvin Mei</h1>

  <nav aria-label="Social links" class="mb-4">
    <ul class="list-none flex gap-4 m-0 p-0">
      <li>
        <a
          href="https://github.com/alkmei"
          aria-label="Visit my Github profile"
          class="underline hover:text-stone-600"
        >
          Github
        </a>
      </li>
      <li>
        <a
          href="https://www.linkedin.com/in/alvinmei"
          aria-label="Visit my LinkedIn profile"
          class="underline hover:text-stone-600"
        >
          LinkedIn
        </a>
      </li>
    </ul>
  </nav>

  <p>I miss shrimp Jesus.</p>

  <section aria-label="Projects" class="mt-6">
    <h2 class="mb-3 text-lg font-bold">
      Side Projects (in no particular order)
    </h2>
    <div class="space-y-4">
      {
        projects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            link={`/projects/${project.id}`}
          />
        ))
      }
    </div>
  </section>
</Layout>
