---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>Alvin Mei</title>
  </head>
  <body
    class="font-serif min-h-screen bg-stone-300 text-stone-900 flex w-full flex-col p-4 font-normal md:px-10 md:py-5"
  >
    <main class="w-full md:w-3/4 md:max-w-2xl mx-auto">
      <slot />
    </main>

    <footer class="mt-4 text-center">
      <aside>
        <p>Contact me at alvinkmei [at] gmail.com</p>
      </aside>
    </footer>
  </body>
</html>
